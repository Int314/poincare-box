{
  "name": "poincare-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "100個の粒子が全部左半分に集まる日を待つサイト（ポアンカレの回帰定理）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "verify": "node tools/verify.mjs",
    "og": "node tools/make-og.mjs",
    "db:local": "wrangler d1 execute poincare-box-db --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute poincare-box-db --remote --file=db/schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
