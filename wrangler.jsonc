{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poincare-box",
  "routes": [{ "pattern": "poincare-box.int314.dev", "custom_domain": true }],
  "workers_dev": true, // routes があると既定 false になる。旧 URL の 301 のために残す
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // 旧 workers.dev → 新ホストの 301 を全パスで効かせる（既定ではアセット一致時に Worker を通らない）
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poincare-box-db",
      "database_id": "98673595-ed7e-4f3b-9620-f3a27b622127"
    }
  ],
  // 日次で追いつき集計。30秒刻みは tick から決定論的に導出されるので
  // Cron Trigger の最短 1 分制約は関係ない。
  "triggers": {
    "crons": ["17 15 * * *"] // 毎日 00:17 JST
  },
  "observability": {
    "enabled": true
  }
}
